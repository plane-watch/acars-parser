<!--
ClickHouse's own diagnostic logs (system.*_log) are kept for 7 days. Without
a TTL they grow without bound: on the collector they reached about 6 GB.
ClickHouse merges this file into its configuration; at startup it recreates
a log table whose definition changed, keeping the old one as <name>_0.
-->
<clickhouse>
    <asynchronous_metric_log>
        <ttl>event_date + INTERVAL 7 DAY DELETE</ttl>
    </asynchronous_metric_log>
    <background_schedule_pool_log>
        <ttl>event_date + INTERVAL 7 DAY DELETE</ttl>
    </background_schedule_pool_log>
    <error_log>
        <ttl>event_date + INTERVAL 7 DAY DELETE</ttl>
    </error_log>
    <metric_log>
        <ttl>event_date + INTERVAL 7 DAY DELETE</ttl>
    </metric_log>
    <part_log>
        <ttl>event_date + INTERVAL 7 DAY DELETE</ttl>
    </part_log>
    <processors_profile_log>
        <ttl>event_date + INTERVAL 7 DAY DELETE</ttl>
    </processors_profile_log>
    <query_log>
        <ttl>event_date + INTERVAL 7 DAY DELETE</ttl>
    </query_log>
    <query_metric_log>
        <ttl>event_date + INTERVAL 7 DAY DELETE</ttl>
    </query_metric_log>
    <text_log>
        <ttl>event_date + INTERVAL 7 DAY DELETE</ttl>
    </text_log>
    <trace_log>
        <ttl>event_date + INTERVAL 7 DAY DELETE</ttl>
    </trace_log>
</clickhouse>
